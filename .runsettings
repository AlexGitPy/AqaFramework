<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <NUnit>
    <NumberOfTestWorkers>4</NumberOfTestWorkers>
  </NUnit>
  <Playwright>
    <BrowserName>chromium</BrowserName>
    <LaunchOptions>
      <Headless>false</Headless>
      <!-- пауза перед каждым действием, чтобы успеть увидеть шаги в окне -->
      <SlowMo>500</SlowMo>
    </LaunchOptions>
  </Playwright>
  <LoggerRunSettings>
    <Loggers>
      <!-- detailed — в консоли видны имена тестов и шаги из Log.Step -->
      <Logger friendlyName="console" enabled="True">
        <Configuration>
          <Verbosity>detailed</Verbosity>
        </Configuration>
      </Logger>
    </Loggers>
  </LoggerRunSettings>
</RunSettings>
